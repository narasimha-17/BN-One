# Copy this file to .env (for local work) or set these in your hosting dashboard, then rebuild.

# --- Enquiry storage -------------------------------------------------------
# Paste the form endpoint from a service such as Formspree (https://formspree.io), Web3Forms
# (https://web3forms.com) or Basin. Every booking, newsletter and early-access form is then stored
# there and emailed to you. Leave empty to keep the old behaviour (opens the visitor's email app).
VITE_FORM_ENDPOINT=
# Only needed for Web3Forms:
VITE_FORM_ACCESS_KEY=

# --- Analytics -------------------------------------------------------------
# Your site's domain as registered at https://plausible.io (for example infortia.com).
# Analytics only load after a visitor allows "Analytics" in the cookie settings.
VITE_PLAUSIBLE_DOMAIN=

# --- Sitemap ---------------------------------------------------------------
# Your real domain. Used to build sitemap.xml and robots.txt during the build.
SITE_URL=https://infortia.com
